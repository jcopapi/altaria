extends "res://tests/cartoon_runtime.gd"
func player_feet_y() -> float:
    var bodies:=actor.find_children("*","CharacterBody3D",true,false)
    if bodies.is_empty():return actor.global_position.y
    for node in bodies[0].find_children("*","CollisionShape3D",true,false):
        var collision:=node as CollisionShape3D
        if collision.disabled or collision.shape==null:continue
        var box: AABB=collision.global_transform*collision.shape.get_debug_mesh().get_aabb()
        return box.position.y
    return actor.global_position.y

func run() -> void:
    game=load("res://scenes/main.tscn").instantiate()
    root.add_child(game)
    await process_frame
    var path:="res://game/world_generation/data/caves.json"
    var original: String=FileAccess.get_file_as_string(path)
    for invalid in [{"roof_grid":0},{"depths":[24,90,190]},{"enabled":"yes"},{"roof_grid":8.5}]:
        var definition: Dictionary=JSON.parse_string(original)
        definition.merge(invalid,true)
        var f:=FileAccess.open(path,FileAccess.WRITE)
        f.store_string(JSON.stringify(definition))
        f.close()
        check(not game.start_world("Invalid cave configuration",1337),"Reject invalid cave configuration "+str(invalid))
    var restored:=FileAccess.open(path,FileAccess.WRITE)
    restored.store_string(original)
    restored.close()
    var biome_path:="res://game/world_generation/data/cave_biomes.json"
    var original_biomes:=FileAccess.get_file_as_string(biome_path)
    for invalid_kind in ["duplicate","missing_rock","liquid_rock","invalid_range","missing_resource","invalid_resource","missing_formation","liquid_formation"]:
        var definition: Dictionary=JSON.parse_string(original_biomes)
        if invalid_kind=="duplicate":definition.definitions.append(definition.definitions[0].duplicate(true))
        elif invalid_kind=="missing_rock":definition.definitions[0].rock="missing:block"
        elif invalid_kind=="liquid_rock":definition.definitions[0].rock="altaria:water"
        elif invalid_kind=="invalid_range":definition.definitions[0].humidity=[0.8,0.2]
        elif invalid_kind=="missing_resource":definition.definitions[0].resource_rules=["example:unregistered"]
        elif invalid_kind=="invalid_resource":definition.resource_rules=[{"id":"example:broken","resource":"example:future","requires_water":"yes"}]
        elif invalid_kind=="missing_formation":definition.definitions[0].formations=["example:unregistered"]
        else:definition.formations[0].rock="altaria:water"
        var f:=FileAccess.open(biome_path,FileAccess.WRITE)
        f.store_string(JSON.stringify(definition))
        f.close()
        check(not game.start_world("Invalid underground catalog",1337),"Reject invalid biome catalog "+invalid_kind)
    restored=FileAccess.open(biome_path,FileAccess.WRITE)
    restored.store_string(original_biomes)
    restored.close()
    check(game.start_world("Cave session test",1337),"Start fixed cave world")
    find_player()
    actor.position=Vector3(100,150,100)
    await settle()
    var state: Dictionary=game.get_debug_state()
    for attempt in range(100):
        if not state.cave_chambers.is_empty():break
        await create_timer(.01).timeout
        state=game.get_debug_state()
    print("CAVE_RESIDENT_STATE player=",actor.position," cache_regions=",state.get("cave_cache_regions",-1)," pinned=",state.get("cave_pinned_cache_regions",-1)," misses=",state.get("cave_cache_misses",-1)," pending=",state.pending," rooms=",state.cave_chambers.size())
    check(game.execute_command("light follow #62a6ff 8 40") == "Following light updated.",
        "Create a colored exploration light")
    var lamp := camera.find_child("ExplorationLight", false, false) as OmniLight3D
    check(lamp != null and lamp.visible and lamp.shadow_enabled, "The light follows the player camera")
    if lamp != null:
        check(game.execute_command("light follow #d87a40") == "Following light updated."
            and lamp.light_color.to_html(false) == "d87a40" and is_equal_approx(lamp.omni_range, 40),
            "Changing lamp color preserves its range")
        check(game.execute_command("light follow off") == "Following light off." and not lamp.visible,
            "Turn off the exploration light")
    check(state.caves_enabled,"Cave fixture enabled")
    check(state.cave_chambers.size()>0,"Resident network generated by workers")
    check(state.get("cave_pinned_cache_regions",0)>0,"Loaded near chunks pin their cave plans")
    check(game.execute_command("cave map").begins_with("Cave map on"),"Open the resident network map")
    check(game.get_debug_state().cave_map_visible and game.get_debug_state().cave_map_surfaces==1,"Map builds a line mesh")
    check(game.execute_command("cave map")=="Cave map off.","Close the resident network map")
    check(not game.get_debug_state().cave_map_visible and game.get_debug_state().cave_map_surfaces==0,"Map frees line mesh when closed")
    var inspect_misses: int=game.get_debug_state().cave_cache_misses
    check(not game.get_cave_formations().is_empty(),"Inspect resident formations")
    check(game.execute_command("cave formations").contains("cave feature"),"Formation console command")
    check(game.execute_command("cave feature -1").begins_with("Invalid"),"Formation index validation")
    check(game.get_debug_state().cave_cache_misses==inspect_misses,"Formation inspection does not start cold plans")
    # The active CharacterBody controller also waits for streamed Jolt terrain.
    # A teleport must not fall through a region before its first collider exists.
    var previous: Vector3=game.get_debug_state().player_position
    game.execute_command("tp -45000 -200 45000")
    game.execute_command("fly off")
    actor.set_physics_process(true)
    var unloaded: Vector3=game.get_debug_state().player_position
    check(not game.get_debug_state().player_collision_ready,"Streaming fixture starts outside loaded collision")
    for frame in range(8):
        await physics_frame
        var waiting: Dictionary=game.get_debug_state()
        if waiting.player_collision_ready:
            break
        check(waiting.player_position.distance_to(unloaded)<.02,
            "Active controller waits instead of falling into an unloaded cave")
    actor.set_physics_process(false)
    game.execute_command("fly on")
    game.execute_command("tp "+str(previous.x)+" "+str(previous.y)+" "+str(previous.z))
    await settle()
    # Climate/debug queries must not plan chunks, even far from the viewer.
    var misses_before: int=game.get_debug_state().cave_cache_misses
    var distribution: Dictionary={}
    var depths: Dictionary={}
    var frozen_crystal:=false
    var hydrothermal_abyssal:=false
    for z in range(-6000,6001,500):
        for x in range(-6000,6001,500):
            var base: Dictionary=game.get_cave_environment(Vector3(x,0,z))
            for depth in [24,90,190,340]:
                var env: Dictionary=game.get_cave_environment(Vector3(x,base.surface_height-depth,z))
                if env.is_empty():continue
                distribution[env.biome]=distribution.get(env.biome,0)+1
                depths[env.depth]=true
                var total:=0.0
                for weight in env.depth_weights:total+=weight
                check(abs(total-1)<0.0001,"Normalized live depth weights")
                if depth>=340:check(env.surface_influence==0,"Surface influence disappears at depth")
                frozen_crystal=frozen_crystal or (env.biome=="altaria:crystal" and env.frozen>.1)
                hydrothermal_abyssal=hydrothermal_abyssal or (env.biome=="altaria:hydrothermal" and env.depth=="abyssal")
    print("CAVE_BIOME_DISTRIBUTION ",distribution," depths=",depths," frozen_crystal=",frozen_crystal," hydrothermal_abyssal=",hydrothermal_abyssal)
    for biome in JSON.parse_string(original_biomes).definitions:
        if biome.get("requires_water",false):
            check(not distribution.has(biome.id),"Water-only biome stays out of dry terrain")
        else:
            check(distribution.has(biome.id),"Live distribution contains "+biome.id)
    check(depths.size()==4,"Four depth categories integrated in the live classifier")
    check(frozen_crystal and hydrothermal_abyssal,"Underground biome combinations")
    check(game.get_debug_state().cave_cache_misses==misses_before,"Environment queries do not build cave plans")
    if not state.cave_chambers.is_empty():
        # The shallow hub opens into a shaft deeper than the local streaming
        # window. Test landing from the final chamber where its floor is loaded.
        var room: Dictionary=state.cave_chambers[0]
        for chamber in state.cave_chambers:
            if chamber.center.y < room.center.y:
                room = chamber
        actor.position=room.center
        var p:=Vector3i(room.center.floor())
        var below_room: Vector3 = room.center - Vector3.UP * (room.radius.y + 8.0)
        for attempt in range(1800):
            var stream: Dictionary = game.get_debug_state()
            if (stream.stream_underground and stream.pending == 0 and stream.tiles == stream.wanted
                    and game.get_cave_environment(below_room).loaded):
                break
            await create_timer(.02).timeout
        check(game.get_cave_environment(below_room).loaded, "The destination cave floor is resident")
        check(game.get_voxel(p.x,p.y,p.z)==0,"Logical cave center is air")
        # Exercise the actual native player collision callback against a cave
        # floor, rather than assuming mesh/volume agreement proves movement.
        var ground:=p.y-1
        while ground>=-448 and game.get_voxel(p.x,ground,p.z)==0:ground-=1
        check(ground>=-448,"Find a logical solid cave floor")
        actor.position=Vector3(p.x+.5,ground+5,p.z+.5)
        game.execute_command("fly off")
        actor.set_physics_process(true)
        await create_timer(1.2).timeout
        print("CAVE_PLAYER_LANDING floor=",ground," player=",actor.position," feet_y=",player_feet_y()," grounded=",game.get_debug_state().grounded," pending=",game.get_debug_state().pending)
        check(game.get_debug_state().grounded and abs(player_feet_y()-ground-1)<.04,"Active player lands on cave floor")
        actor.set_physics_process(false)
        game.execute_command("fly on")
        actor.position=Vector3(p.x+8,ground+8,p.z)
        # A real Jolt body uses the uploaded interior collider.
        check(game.set_voxel(p.x,ground+5,p.z,1),"Create cave debris fixture")
        check(game.release_voxel(p.x,ground+5,p.z,false),"Release cave block into Jolt")
        await settle()
        await create_timer(2.0).timeout
        var bodies: Array=game.get_debug_state().physics_positions
        print("CAVE_JOLT_FIXTURE floor=",Vector3(p.x,ground,p.z)," positions=",bodies," pending=",game.get_debug_state().pending)
        check(bodies.size()==1 and abs(bodies[0].y-ground-1)<.15,"Jolt debris lands on the carved cave collider")
        game.execute_command("physics clear")
        check(game.set_voxel(p.x,ground+1,p.z,1) and game.shape_voxel(p.x,ground+1,p.z,"slab",0),"Build a procedural slab collision fixture")
        await settle()
        check(game.set_voxel(p.x,ground+6,p.z,1) and game.release_voxel(p.x,ground+6,p.z,false),"Drop a block onto the procedural slab")
        await settle()
        await create_timer(2.0).timeout
        bodies=game.get_debug_state().physics_positions
        check(bodies.size()==1 and abs(bodies[0].y-ground-1.5)<.15,"Packed collider preserves the exact slab height")
        game.execute_command("physics clear")
        game.set_voxel(p.x,ground+1,p.z,0)
        await settle()
        # Authored partial forms still stack at their actual height underground.
        var slab: int=game.place_block(Vector3(p.x,ground+1,p.z),1,"slab",0)
        var cube: int=game.place_block(Vector3(p.x,ground+1.5,p.z),1,"cube",0)
        check(slab>0 and cube>0,"Fractional construction inside a cave")
        if cube>0:game.remove_built_block(cube)
        if slab>0:game.remove_built_block(slab)
        actor.position=room.center
        check(game.set_voxel(p.x,p.y,p.z,1),"Build in a cave")
        var before: int=game.get_debug_state().cave_cache_misses
        check(game.paint_voxel(p.x,p.y,p.z,"#aabbcc",.4,1.0),"Paint uses loaded support")
        check(not game.paint_voxel(800000,-200,800000,"#ffffff",.4,1.0),"Unknown support rejects paint without planning")
        check(game.get_debug_state().cave_cache_misses==before,"Paint does not trigger a cold plan")
        var far:=Vector3(-5000,180,-5000)
        actor.position=far
        await settle()
        actor.position=room.center
        await settle()
        check(game.get_voxel(p.x,p.y,p.z)==1,"Placed block survives actual chunk eviction and return")
        check(game.get_voxel_appearance(p.x,p.y,p.z).painted,"Paint survives chunk eviction")
        check(game.set_voxel(p.x,p.y,p.z,0),"Break cave fixture block")
        actor.position=far
        await settle()
        actor.position=room.center
        await settle()
        check(game.get_voxel(p.x,p.y,p.z)==0,"Removal survives actual chunk eviction and return")
        check(game.execute_command("world new 1337").begins_with("Generating"),"New test world")
        find_player()
        actor.position=room.center
        await settle()
        check(game.get_debug_state().edits==0,"New test clears session edits")
    check(not DirAccess.dir_exists_absolute("user://worlds"),"No disk world directory")
    root.remove_child(game)
    game.queue_free()
    for i in range(4):await process_frame
    print("CAVE_RUNTIME_PASS" if failures.is_empty() else "CAVE_RUNTIME_FAIL "+str(failures))
    quit(0 if failures.is_empty() else 1)
